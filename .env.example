SERVER_HOST=
SERVER_PORT=
SERVER_HEADER_NAME=
SERVER_PREFORK=

DATABASE_DRIVER=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL_MODE=
DATABASE_ENCRYPTION_KEY=
# Where the root key comes from. "env" (default) reads DATABASE_ENCRYPTION_KEY.
# An unrecognised value fails the cipher build closed — secret-writing routes are
# disabled rather than downgraded to plaintext.
AO_DATABASE_ROOT_KEY_PROVIDER=
# The PREVIOUS root key, read only by `rotate-root-key`. See docs/root-key-rotation.md.
AO_PRIOR_DATABASE_ENCRYPTION_KEY=
DATABASE_POOL_MAX_IDLE_CONNS=
DATABASE_POOL_MAX_OPEN_CONNS=
DATABASE_POOL_MAX_CONN_LIFETIME=
DATABASE_POOL_MAX_CONN_IDLE_TIME=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DATABASE=

LOG_LEVEL=
LOG_FORMATTER_FORMAT=

NEXT_PUBLIC_BASE_PATH=
AO_API_URL=
PORTAL_URL=
COOKIE_SECURE=
OIDC_ISSUER=
AO_LOGIN_URL=
# Login-ui BFF shared PAT. Comma-separate to accept several during a rotation:
# add the new value here, roll the BFF onto it, then remove the old one — three
# independent deploys instead of one synchronised restart. A blank entry (a stray
# trailing comma) is refused at startup.
#
# The BFF forwards the end user's address as X-Forwarded-For so the limiter's
# per-IP dimension is live. Fiber only honours that header from a trusted peer,
# so if the BFF runs OFF-HOST its origin must be in AO_SERVER_TRUSTED_PROXIES
# (default {127.0.0.1/32, ::1/128} covers a co-located deployment). Widen it to
# the BFF's address only — never to a public range, or the header becomes
# client-forgeable and the dimension becomes evadeable.
AO_LOGIN_UI_PAT=
# WebAuthn RP ID override for the login + self-service account passkey ceremonies.
# Leave EMPTY in production (RP ID is derived per request as the host registrable
# domain, eTLD+1). Set only for non-registrable dev domains, e.g. acme.test.
AO_WEBAUTHN_RP_ID=

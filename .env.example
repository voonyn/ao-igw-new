APP_NAME=
APP_VERSION=
APP_ENVIRONMENT=
APP_TIMEZONE=
APP_URL=

SERVER_HOST=
SERVER_PORT=
SERVER_HEADER_NAME=
SERVER_PREFORK=

DATABASE_DRIVER=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL_MODE=
DATABASE_ENCRYPTION_KEY=
# Where the root key comes from. "env" (default) reads DATABASE_ENCRYPTION_KEY.
# An unrecognised value fails the cipher build closed — secret-writing routes are
# disabled rather than downgraded to plaintext.
AO_DATABASE_ROOT_KEY_PROVIDER=
# The PREVIOUS root key, read only by `rotate-root-key`. See docs/root-key-rotation.md.
AO_PRIOR_DATABASE_ENCRYPTION_KEY=
DATABASE_POOL_MAX_IDLE_CONNS=
DATABASE_POOL_MAX_OPEN_CONNS=
DATABASE_POOL_MAX_CONN_LIFETIME=
DATABASE_POOL_MAX_CONN_IDLE_TIME=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DATABASE=

LOG_LEVEL=
LOG_FORMATTER_FORMAT=

NEXT_PUBLIC_BASE_PATH=
AO_API_URL=
PORTAL_URL=
COOKIE_SECURE=
OIDC_ISSUER=
AO_LOGIN_URL=
# Login-ui BFF shared PAT. Comma-separate to accept several during a rotation:
# add the new value here, roll the BFF onto it, then remove the old one — three
# independent deploys instead of one synchronised restart. A blank entry (a stray
# trailing comma) is refused at startup.
#
# The BFF forwards the end user's address as X-Forwarded-For so the limiter's
# per-IP dimension is live. Fiber only honours that header from a trusted peer,
# so if the BFF runs OFF-HOST its origin must be in AO_SERVER_TRUSTED_PROXIES
# (default {127.0.0.1/32, ::1/128} covers a co-located deployment). Widen it to
# the BFF's address only — never to a public range, or the header becomes
# client-forgeable and the dimension becomes evadeable.
AO_LOGIN_UI_PAT=
# WebAuthn RP ID override for the login + self-service account passkey ceremonies.
# Leave EMPTY in production (RP ID is derived per request as the host registrable
# domain, eTLD+1). Set only for non-registrable dev domains, e.g. acme.test.
AO_WEBAUTHN_RP_ID=
# Deployment origins a passkey ceremony may run from, comma-separated, each one a
# whole origin with its scheme and its port. Name the portal and the console here.
# The tenant's own verified hosts are added per request from its domain rows, so
# they do not belong in this list.
#
# Only the origins the tenant's RP ID covers are used. A device binds its key pair
# to that RP ID, so a portal on another registrable domain can register no passkey
# for that tenant, whatever this setting names. Put the portal and the console
# under the same registrable domain as the tenant hosts.
#
# The WebAuthn library refuses to start with an empty origin list, so a deployment
# that leaves both this and the tenant domains empty runs no ceremony. Example:
# AO_WEBAUTHN_ORIGINS=https://portal.acme.com,https://console.acme.com
AO_WEBAUTHN_ORIGINS=
# URN prefix of the two acr values the ID token publishes: <prefix>:1fa for one
# factor, <prefix>:2fa for two or more. Empty uses urn:alphaomega:acr. The values
# are a published contract, so set this once and never change it after clients
# arrive.
AO_OIDC_ACR_PREFIX=

# --- Digital Identity (the Scan Verifier behind QR Login and DI Enrolment) ---
# AO_DI_ENABLED switches the whole integration. With it false, no route is
# mounted, nothing calls the Scan Verifier, and the capability endpoint at
# /api/v1/capabilities answers off. Both front ends read that endpoint, so there
# is one switch and not two that drift apart.
#
# The two credential pairs are different credentials in opposite directions.
# AO_DI_CLIENT_* authenticates this deployment to the Scan Verifier.
# AO_DI_CALLBACK_CLIENT_* is what the Scan Verifier presents on its push
# callback. Both pairs also differ from AO_LOGIN_UI_PAT.
#
# A pair set on one half only refuses to start the integration, because a typo
# must never decide who gets in. The callback pair is required: the endpoint
# behind it succeeds by signing a person in, so it is never mounted open.
AO_DI_ENABLED=false
AO_DI_BASE_URL=
AO_DI_CLIENT_ID=
AO_DI_CLIENT_SECRET=
AO_DI_CALLBACK_CLIENT_ID=
AO_DI_CALLBACK_CLIENT_SECRET=
# The presentation-definition descriptor id the wallet is asked for. The Scan
# Verifier matches the credential by it. Empty falls back to "identity".
AO_DI_INPUT_DESCRIPTOR_ID=
# One round trip to the Scan Verifier. Empty falls back to 10s.
AO_DI_TIMEOUT=

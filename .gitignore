# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.stackdump

# Test binary, built with `go test -c`
*.test
tmp/

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
vendor/

# logs
logs/*

# Go workspace file
go.work
go.work.sum

# env files
.env
.env.local
**/.env.local

# claude
.claude/
.codegraph/

# Editor/IDE
# .idea/
# .vscode/
.gstack/

# ── GSD baseline (auto-generated) ──
.gsd
.gsd-id
.mcp.json
.bg-shell/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
.env.*
!.env.example
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
*.log
coverage/
.cache/

# mattpocock files
.scratch/

# AlphaOmega Admin Console — environment template.
#
# Copy to `.env.local` and fill in the real values. All of them are read
# server-side only (no NEXT_PUBLIC_ prefix), so they never reach the browser
# bundle. Changing them takes effect on a process restart — no rebuild needed.
#
# `.env*` is gitignored; commit this template with `git add -f .env.example`
# if you want it tracked.

# The gateway issuer for this instance. The console fetches
# `${AO_OIDC_ISSUER}/.well-known/openid-configuration` server-side, and this
# must equal the `iss` claim the gateway puts in its tokens.
AO_OIDC_ISSUER=https://dev-ao.alpha-omega.io

# The bootstrap-seeded `console-ui` OIDC client_id (a random UUID printed once
# by `bootstrap`). Recover it from the DB if lost:
#   SELECT c.client_id FROM application_oidc_configs c
#     JOIN applications a ON a.id = c.app_id WHERE a.name = 'console-ui';
AO_OIDC_CLIENT_ID=

# Gateway base URL that serves /api/v1/admin/*. Usually the same host as the
# issuer. The BFF attaches the bearer to these calls server-side.
AO_ADMIN_API_BASE=https://dev-ao.alpha-omega.io

# This console's own public origin. Used to build the redirect URI
# (`${AO_CONSOLE_URL}/auth/callback`) and the open-redirect allowlist. It MUST
# match the redirect_uris registered for the `console-ui` app at bootstrap.
AO_CONSOLE_URL=https://dev-console.alpha-omega.io

# The environment this deployment serves, rendered as the topbar badge. Free
# text — whatever an operator needs to see ("Production", "Staging", "Dev",
# "eu-prod"). UNSET RENDERS NO BADGE, deliberately: a truth indicator that
# defaults to the most reassuring value is worse than no indicator. Read in the
# `(console)` server layout and passed to the topbar as a prop.
AO_CONSOLE_ENV=Development

# Secret (>= 32 chars) that seals the console's session + pending-flow cookies
# (JWE, dir+A256GCM). The BFF is stateless: tokens live only in these encrypted
# httpOnly cookies, never in a server-side store — so no Redis, and the console
# runs across N replicas (HA) and survives `next dev` route re-eval. REQUIRED
# outside development (unset in production is fatal); dev falls back to an
# insecure key with a warning. Generate one with e.g. `openssl rand -base64 32`.
AO_CONSOLE_COOKIE_SECRET=

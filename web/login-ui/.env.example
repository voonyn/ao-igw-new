# Local dev env for the login-ui BFF. Read only by the Next.js server
# (server components + Server Actions); never exposed to the browser bundle.
# Gitignored — do not commit.

# Must match the gateway's AO_LOGIN_UI_PAT (root .env). The Server Actions send
# this as the X-Login-UI-PAT header; a mismatch makes the gateway return
# {"error":"unauthorized"}.
AO_LOGIN_UI_PAT=

# Base URL of the Go gateway the BFF calls server-side.
AO_API_URL=

# Allowlist for the standalone (non-OIDC) post-login `redirect_uri`. Comma-
# separated origins or bare hosts; the login-ui's own host is always allowed.
# A `?redirect_uri=` whose host is not listed (and is not a same-origin relative
# path) is rejected to prevent open redirects, falling back to the signed-in
# screen. Leave empty to allow only same-origin returns.
AO_POST_LOGIN_ALLOWED_ORIGINS=

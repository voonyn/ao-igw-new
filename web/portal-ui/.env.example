# AlphaOmega self-service portal — environment template.
#
# Copy to `.env.local` and fill in the real values. All of them are read
# server-side only (no NEXT_PUBLIC_ prefix), so they never reach the browser
# bundle. A change takes effect on a process restart. No rebuild is necessary.
#
# `.env*` is gitignored. To track this template, run
# `git add -f web/portal-ui/.env.example`.

# The gateway issuer for this instance. The portal fetches
# `${AO_OIDC_ISSUER}/.well-known/openid-configuration` server-side, and this
# must equal the `iss` claim the gateway puts in its tokens. It is also the
# base of the self-service account API (`/api/v1/account/*`) that the BFF
# proxy calls. Default: http://auth.localhost:8080
AO_OIDC_ISSUER=http://auth.localhost:8080

# The bootstrap-seeded `portal-ui` OIDC client_id (a random UUID printed once
# by `bootstrap`). The portal is a public client: authorization_code with PKCE
# and no client secret. Recover the id from the DB if lost:
#   SELECT c.client_id FROM application_oidc_configs c
#     JOIN applications a ON a.id = c.app_id WHERE a.name = 'portal-ui';
AO_OIDC_CLIENT_ID=

# This portal's own public origin. The portal builds the redirect URI
# (`${AO_PORTAL_URL}/auth/callback`), the post-logout URI (`${AO_PORTAL_URL}/`)
# and the open-redirect allowlist from it. It MUST match the redirect_uris
# registered for the `portal-ui` app at bootstrap. Default: http://localhost:3001
AO_PORTAL_URL=http://localhost:3001

# RFC 8707 resource indicator sent at `/authorize`, so the access token `aud`
# designates the account API. The account resource server rejects a token that
# lacks it. Keep it equal to `oidc.AccountAudience` in the Go gateway.
# Default: urn:alphaomega:account-api
AO_OIDC_ACCOUNT_RESOURCE=urn:alphaomega:account-api

# Secret (>= 32 chars) that seals the portal session and pending-flow cookies
# (JWE, dir+A256GCM). The BFF is stateless: tokens live only in these encrypted
# httpOnly cookies, never in a server-side store. The portal therefore runs
# across N replicas and survives a `next dev` route re-evaluation. REQUIRED
# outside development: an unset value in production is fatal. Development falls
# back to an insecure key and prints a warning. Generate a secret with
# `openssl rand -base64 32`.
AO_PORTAL_COOKIE_SECRET=
